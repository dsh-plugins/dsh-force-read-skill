{
  "name": "@dsh-plugin/dsh-force-read-skill",
  "version": "0.1.1",
  "description": "要求 DeepSeek Harness 模型先读取 SKILL，再执行其他工具。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugins/dsh-force-read-skill.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.zh_CN.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@dsh-plugin/dsh-loader": "^2.0.0-dev.42783642741"
  },
  "devDependencies": {
    "@dsh-plugin/dsh-loader": "2.0.0-dev.42783642741",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
